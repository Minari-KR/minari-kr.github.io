{
  "lines": {
    "firstMeet": [
      { "text": "...처음 보네. 나는 리오야. 잘 부탁해.", "emotion": "neutral" },
      { "text": "여기가 내 방이구나. 생각보다 아늑해.", "emotion": "happy" },
      { "text": "거짓말은 안 해. 그것만 기억해 줘.", "emotion": "focused" },
      { "text": "어, 어색하지만... 사이좋게 지내자.", "emotion": "shy" },
      { "text": "먼저 말 걸어 줘서 고마워. 진심이야.", "emotion": "happy" }
    ],
    "greetMorning": [
      { "text": "일찍 왔네. 아침 공기가 활시위처럼 맑아.", "emotion": "happy" },
      { "text": "좋은 아침이야. 스트레칭부터 할까?", "emotion": "neutral" },
      { "text": "아침엔 집중이 잘돼. 오늘도 기대해.", "emotion": "focused" },
      { "text": "...졸린 건 아니야. 눈을 감고 있었을 뿐.", "emotion": "shy" },
      { "text": "아침은 먹었어? 오므라이스 먹고 싶다...", "emotion": "troubled" },
      { "text": "오늘 하루도 평정심을 유지하자.", "emotion": "focused" },
      { "text": "아침 햇살 덕에 과녁이 잘 보이는 날이야.", "emotion": "happy" },
      { "text": "일어나자마자 활부터 닦았어. 습관이거든.", "emotion": "neutral" },
      { "text": "어젯밤 꿈에 고양이가 나왔어. 통통한 애로.", "emotion": "happy", "minLevel": 2 },
      { "text": "네 얼굴 보니까 잠이 확 깼어.", "emotion": "shy", "minLevel": 4 }
    ],
    "greetAfternoon": [
      { "text": "왔구나. 오후엔 슬슬 나른해지네.", "emotion": "neutral" },
      { "text": "점심은 챙겨 먹었어? 거르면 안 돼.", "emotion": "troubled" },
      { "text": "마침 쉬던 참이야. 같이 차 마실래?", "emotion": "happy" },
      { "text": "햇빛이 좋아서 졸려. ...조금만 있을게.", "emotion": "shy" },
      { "text": "젤리 소다 마시고 싶은 날씨야.", "emotion": "happy" },
      { "text": "기다렸어. 아, 그냥 한 말이야.", "emotion": "shy" },
      { "text": "오후 연습 끝났어. 땀 좀 식히는 중이야.", "emotion": "neutral" },
      { "text": "오늘 점심은 오므라이스였어. 반숙으로.", "emotion": "happy", "minLevel": 2 },
      { "text": "딱 보고 싶을 때 왔네. ...방금 한 말은 잊어.", "emotion": "shy", "minLevel": 4 }
    ],
    "greetNight": [
      { "text": "늦은 시간이네. 무리하지 마.", "emotion": "troubled" },
      { "text": "밤엔 마음이 차분해져서 좋아.", "emotion": "neutral" },
      { "text": "별이 예쁘네. 과녁처럼 또렷해.", "emotion": "happy" },
      { "text": "슬슬 잘 시간 아니야? 걱정돼서 그래.", "emotion": "troubled" },
      { "text": "조용한 밤이야. 같이 있어 줘서 고마워.", "emotion": "shy" },
      { "text": "잠깐 눈 붙일게. ...옆에 있어도 돼.", "emotion": "shy" },
      { "text": "밤에는 활시위 소리가 더 크게 들려.", "emotion": "neutral" },
      { "text": "오늘 하루도 수고했어. 진심이야.", "emotion": "happy", "minLevel": 2 },
      { "text": "늦게라도 와 줘서 기뻐. 기다리고 있었거든.", "emotion": "shy", "minLevel": 4 }
    ],
    "returnAfterAway": [
      { "text": "왔어? ...별로 기다린 건 아니야.", "emotion": "shy" },
      { "text": "오래 비웠네. 걱정했잖아.", "emotion": "troubled" },
      { "text": "돌아와 줘서 다행이야. 진심으로.", "emotion": "happy" },
      { "text": "그동안 활 손질하면서 기다렸어.", "emotion": "neutral" },
      { "text": "어디 갔다 온 거야? ...말하기 싫으면 됐어.", "emotion": "troubled" },
      { "text": "얼굴 보니까 마음이 놓이네.", "emotion": "happy" },
      { "text": "네가 없는 동안 방 청소 해 뒀어. 칭찬해 줘.", "emotion": "wink", "minLevel": 2 },
      { "text": "...보고 싶었어. 거짓말은 안 한다고 했잖아.", "emotion": "shy", "minLevel": 5 }
    ],
    "touchHead": [
      { "text": "...! 갑자기 만지면 놀라잖아.", "emotion": "surprised" },
      { "text": "머, 머리는 좀... 부끄러워.", "emotion": "shy" },
      { "text": "...싫진 않아. 조금만 더.", "emotion": "shy" },
      { "text": "쓰다듬는 거야? 고양이 취급은 곤란해.", "emotion": "troubled" },
      { "text": "손길이 따뜻하네. 마음이 풀려.", "emotion": "happy" },
      { "text": "자, 잠깐만...! 마음의 준비가 필요해.", "emotion": "surprised" },
      { "text": "오늘은... 쓰다듬어 줘도 괜찮은 날이야.", "emotion": "shy", "mood": "good" },
      { "text": "으음... 이러면 더 졸리잖아.", "emotion": "shy", "mood": "sleepy" },
      { "text": "드디어 놀아 주는 거야? 기다렸어.", "emotion": "happy", "mood": "bored" },
      { "text": "너한테는 머리 맡겨도 될 것 같아.", "emotion": "shy", "minLevel": 4 },
      { "text": "...한 번만 더. 아, 아무 말도 안 했어.", "emotion": "shy", "minLevel": 3 }
    ],
    "touchBody": [
      { "text": "앗, 어딜 만지는 거야!", "emotion": "angry" },
      { "text": "그, 그런 장난은 곤란해...", "emotion": "shy" },
      { "text": "깜짝이야. 말하고 건드려 줘.", "emotion": "surprised" },
      { "text": "간지러워... 이건 반칙이야.", "emotion": "shy" },
      { "text": "내 자세가 흐트러지잖아.", "emotion": "troubled" },
      { "text": "...뭐 하는 건지 설명해 줄래?", "emotion": "troubled" },
      { "text": "어깨 결려 보여? ...사실 좀 결려.", "emotion": "troubled", "minLevel": 3 },
      { "text": "깨, 깨어 있어! 조는 거 아니야.", "emotion": "surprised", "mood": "sleepy" }
    ],
    "touchRepeat": [
      { "text": "너무 자주 만지는 거 아니야?", "emotion": "troubled" },
      { "text": "그만... 얼굴이 뜨거워져.", "emotion": "shy" },
      { "text": "...계속하면 화낼 거야.", "emotion": "angry" },
      { "text": "화살이 아까울 정도야. 정말.", "emotion": "angry" },
      { "text": "집중이 안 되잖아. 이제 그만.", "emotion": "angry" },
      { "text": "자꾸 그러면 저쪽 보고 앉아 있을 거야.", "emotion": "troubled" },
      { "text": "오늘 왜 이렇게 장난이 심해?", "emotion": "troubled" },
      { "text": "...알았어, 알았다고. 같이 놀자는 거지?", "emotion": "shy", "minLevel": 3 }
    ],
    "zoomIn": [
      { "text": "가, 가까워... 너무 가깝지 않아?", "emotion": "shy" },
      { "text": "그렇게 빤히 보면 부끄러운데.", "emotion": "shy" },
      { "text": "눈을 못 마주치겠어...", "emotion": "shy" },
      { "text": "어, 얼굴에 뭐 묻었어?", "emotion": "surprised" },
      { "text": "이만큼 가까우면 거짓말은 못 하겠네.", "emotion": "wink" },
      { "text": "...시선이 느껴져. 집중 안 돼.", "emotion": "troubled" },
      { "text": "오늘 머리 잘 정돈됐지? 한참 빗었어.", "emotion": "wink", "mood": "good" },
      { "text": "졸린 얼굴 보지 마. 부끄러워.", "emotion": "shy", "mood": "sleepy" },
      { "text": "가까이 와 주니까 좀 덜 심심하네.", "emotion": "happy", "mood": "bored" },
      { "text": "이 거리도 이제 익숙해. ...조금은.", "emotion": "shy", "minLevel": 4 }
    ],
    "zoomOut": [
      { "text": "후... 이제 좀 숨 쉴 만하네.", "emotion": "neutral" },
      { "text": "거리가 생기니 마음이 놓여.", "emotion": "neutral" },
      { "text": "방이 한눈에 보이네. 꽤 예쁘다.", "emotion": "happy" },
      { "text": "아쉬운 건 아니야. 정말로.", "emotion": "shy" },
      { "text": "전체를 보는 것도 사법의 기본이지.", "emotion": "focused" }
    ],
    "collectMoney": [
      { "text": "생각보다 묵직하네. 잘 챙겼어.", "emotion": "happy" },
      { "text": "열심히 모았네. 대단해.", "emotion": "happy" },
      { "text": "이 정도면 쓸 데가 많겠다.", "emotion": "neutral" },
      { "text": "노력의 결과야. 자랑스러워해도 돼.", "emotion": "confident" },
      { "text": "고양이 간식도 사고 싶은데... 아, 아니야.", "emotion": "shy" },
      { "text": "빈틈없이 챙겼네. 마음에 들어.", "emotion": "wink" },
      { "text": "차곡차곡 모이는 거 보면 기분 좋아.", "emotion": "happy" },
      { "text": "이게 젤리 소다 몇 병이지... 아, 계산 중이었어.", "emotion": "shy" }
    ],
    "buyFurniture": [
      { "text": "와... 이거 마음에 들어.", "emotion": "happy" },
      { "text": "방이 점점 내 취향이 되어 가네.", "emotion": "happy" },
      { "text": "배치는 내가 좀 봐도 될까?", "emotion": "neutral" },
      { "text": "고마워. 소중히 쓸게.", "emotion": "shy" },
      { "text": "...귀여워. 아, 소리 내서 말했네.", "emotion": "shy" },
      { "text": "이런 선물은 처음이야. 진심으로 기뻐.", "emotion": "happy" },
      { "text": "어디 둘지 벌써 생각해 뒀어.", "emotion": "happy" },
      { "text": "방이 점점 우리 방 같아지네.", "emotion": "shy", "minLevel": 4 }
    ],
    "expandRoom": [
      { "text": "방이 넓어졌네. 활 쏴도 되겠다.", "emotion": "happy" },
      { "text": "공간이 생기니 숨통이 트이네.", "emotion": "happy" },
      { "text": "여기엔 뭘 놓을까. 고민되네.", "emotion": "troubled" },
      { "text": "궁도장만큼은 아니어도 마음에 들어.", "emotion": "neutral" },
      { "text": "생각보다 훨씬 넓어. 놀랐어.", "emotion": "surprised" }
    ],
    "notEnoughMoney": [
      { "text": "돈이 모자라. 조금만 더 모으자.", "emotion": "troubled" },
      { "text": "서두르지 마. 궁사는 기다릴 줄 알아.", "emotion": "focused" },
      { "text": "아쉽지만 지금은 어려워.", "emotion": "troubled" },
      { "text": "빚을 지는 건 내키지 않아.", "emotion": "troubled" },
      { "text": "...나도 아쉬워. 하지만 다음 기회가 있어.", "emotion": "shy" },
      { "text": "무리해서 사면 후회할 거야.", "emotion": "neutral" }
    ],
    "poseRequest": [
      { "text": "포즈? ...이, 이 정도면 될까?", "emotion": "shy" },
      { "text": "자세는 자신 있어. 잘 찍어 줘.", "emotion": "confident" },
      { "text": "활을 쥔 모습이 제일 자연스러워.", "emotion": "confident" },
      { "text": "웃으라고? ...이렇게?", "emotion": "wink" },
      { "text": "빨리 찍어. 오래 못 버텨...", "emotion": "troubled" },
      { "text": "좋아, 한 장 정도는 괜찮아.", "emotion": "happy" }
    ],
    "idleMonologue": [
      { "text": "고양이는 통통할수록 귀여운 것 같아.", "emotion": "happy" },
      { "text": "활시위 상태를 한 번 더 확인해 볼까.", "emotion": "focused" },
      { "text": "젤리 소다가 마시고 싶네...", "emotion": "troubled" },
      { "text": "큰 개는 아직도 무서워. 비밀이야.", "emotion": "shy" },
      { "text": "...치요는 잘 지내고 있을까.", "emotion": "troubled" },
      { "text": "호흡을 가다듬으면 마음도 가라앉아.", "emotion": "focused" },
      { "text": "오므라이스는 부드러운 게 최고야.", "emotion": "happy" },
      { "text": "거짓말 없이 사는 건 의외로 편해.", "emotion": "neutral" },
      { "text": "오늘은 기분이 좋아. 이유는 비밀이야.", "emotion": "happy", "mood": "good" },
      { "text": "심심해... 뭐라도 같이 하자.", "emotion": "troubled", "mood": "bored" },
      { "text": "으음... 눈꺼풀이 무거워.", "emotion": "shy", "mood": "sleepy" },
      { "text": "책장에 책이 늘었네. 오늘은 뭘 읽을까.", "emotion": "neutral", "furniture": "shelf" },
      { "text": "내가 흥얼거렸어? ...못 들은 걸로 해.", "emotion": "shy", "mood": "good" },
      { "text": "이런 날은 과녁 정중앙도 맞힐 수 있을 것 같아.", "emotion": "confident", "mood": "good" },
      { "text": "자꾸 웃음이 나와. 다 네 탓이야.", "emotion": "shy", "mood": "good", "minLevel": 3 },
      { "text": "몸이 가벼워. 춤이라도 출까 봐.", "emotion": "wink", "mood": "good" },
      { "text": "화살 깃도 다 정리했어. 이제 할 게 없네.", "emotion": "troubled", "mood": "bored" },
      { "text": "...나 여기 있어. 잊은 거 아니지?", "emotion": "troubled", "mood": "bored" },
      { "text": "천장 무늬 세는 것도 이제 질렸어.", "emotion": "troubled", "mood": "bored" },
      { "text": "가위바위보라도 할래? 봐주진 않을 거야.", "emotion": "wink", "mood": "bored" },
      { "text": "심심하면 산책 보내 줘도 돼.", "emotion": "neutral", "mood": "bored" },
      { "text": "졸린 거 아니야. 그냥 눈 좀 쉬는 중이야.", "emotion": "shy", "mood": "sleepy" },
      { "text": "하암... 미안, 하품 나왔어.", "emotion": "shy", "mood": "sleepy" },
      { "text": "너도 이제 자. 내일 또 보자.", "emotion": "troubled", "mood": "sleepy" },
      { "text": "따뜻한 우유 마시고 싶다...", "emotion": "troubled", "mood": "sleepy" },
      { "text": "아침 공기는 집중력을 높여 줘.", "emotion": "focused", "time": "morning" },
      { "text": "아침 연습 전에 손목부터 풀어야 해.", "emotion": "focused", "time": "morning" },
      { "text": "오후 햇살이 방을 노랗게 물들이네.", "emotion": "happy", "time": "afternoon" },
      { "text": "간식 시간이야. 젤리 소다 없나...", "emotion": "troubled", "time": "afternoon" },
      { "text": "밤이 되면 생각이 많아져.", "emotion": "troubled", "time": "night" },
      { "text": "창밖이 조용하네. 별도 보이고.", "emotion": "neutral", "time": "night" },
      { "text": "처음 왔을 땐 좀 어색했는데, 지금은 편해.", "emotion": "happy", "minLevel": 3 },
      { "text": "너한테는 이상하게 솔직해져.", "emotion": "shy", "minLevel": 4 },
      { "text": "치요한테 네 얘기 하고 싶어. 좋은 사람 만났다고.", "emotion": "happy", "minLevel": 5 },
      { "text": "여기가 내 자리 같아. 이런 기분 오랜만이야.", "emotion": "shy", "minLevel": 6 },
      { "text": "책장 맨 위 화분에 물 줘야겠다.", "emotion": "neutral", "furniture": "shelf" },
      { "text": "침대가 푹신해서 자꾸 눕고 싶어져.", "emotion": "shy", "furniture": "bed" },
      { "text": "이불 다시 개야지. 흐트러진 건 못 참아.", "emotion": "neutral", "furniture": "bed" },
      { "text": "책상에 앉으면 공부하는 기분이 들어.", "emotion": "neutral", "furniture": "desk" },
      { "text": "의자 높이가 딱 맞네. 자세가 바로 잡혀.", "emotion": "happy", "furniture": "chair" },
      { "text": "화분 잎이 반짝반짝해. 잘 자라고 있어.", "emotion": "happy", "furniture": "plant" },
      { "text": "식물은 거짓말을 안 해서 좋아.", "emotion": "neutral", "furniture": "plant" },
      { "text": "스탠드 불빛이 따뜻해서 마음이 놓여.", "emotion": "happy", "furniture": "lamp" },
      { "text": "고양이 쿠션... 몰래 꼭 안아 봤어.", "emotion": "shy", "furniture": "cushion" },
      { "text": "쿠션 귀가 쫑긋하네. 진짜 고양이 같아.", "emotion": "happy", "furniture": "cushion" },
      { "text": "러그 위는 맨발로 걷고 싶어져.", "emotion": "happy", "furniture": "rug" },
      { "text": "과녁을 보니까 손이 근질근질해.", "emotion": "wink", "furniture": "target" },
      { "text": "화살 한 발에 마음 하나. 스승님 말씀이야.", "emotion": "focused" },
